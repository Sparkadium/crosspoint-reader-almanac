+
+// /tex_moon.bin -> the 4-bit resident buffer. Missing file or heap: photo_
+// turns itself off and the map view carries on.
+bool MoonActivity::ensurePhoto() {
+  if (texOk_) return true;
+  if (!texBuf_) {
+    texBuf_ = (uint8_t*)malloc(tex::RES_BYTES);
+    texLuts_ = new (std::nothrow) tex::Luts;
+    fsErr_ = (int16_t*)malloc(sizeof(int16_t) * 2 * (renderer.getScreenWidth() + 2));
+    if (!texBuf_ || !texLuts_ || !fsErr_) { freePhoto(); photo_ = false; return false; }
+    texLuts_->build();
+  }
+  HalFile tf = Storage.open("/tex_moon.bin", O_RDONLY);
+  bool ok = false;
+  if (tf) { ok = tex::loadResident(tf, (HalFile*)nullptr, texBuf_); tf.close(); }
+  if (!ok) { freePhoto(); photo_ = false; return false; }
+  texOk_ = true;
+  return true;
+}
