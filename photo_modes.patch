+// tex_test.cpp -- host verification for tex_math.h (the photo-globe core).
+//
+//   g++ -O2 -std=c++17 -I../../src/activities/almanac tex_test.cpp -o tex_test
+//   ./tex_test earth_day.bin earth_clouds.bin
+//
+// A. loadResident (box filter + screen blend + 4-bit pack) against
+//    tex_ref.py's integer reference: must be BIT-EXACT.
+// B. Projection (pz/asin/atan LUT path) against double precision over the
+//    full disc at several view angles: reports ty/tx agreement.
+// C. Floyd-Steinberg against tex_ref.py on a synthetic gradient with
+//    identical integer semantics: must be BIT-EXACT.
+// D. Dumps a full render to render.pgm for eyeballing.
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <cmath>
+#include <vector>
+
+#include "tex_math.h"
+
+struct FileReader {
+  FILE* f;
+  int read(void* dst, unsigned n) { return (int)fread(dst, 1, n, f); }
+  void seek(uint32_t pos) { fseek(f, pos, SEEK_SET); }
+};
+
+static const int W = 480, H = 800, R = 214, CX = 240, CY = 360;
+
+int main(int argc, char** argv) {
+  if (argc < 3) { fprintf(stderr, "usage: tex_test day.bin clouds.bin\n"); return 1; }
+
+  // ---------- A: resident load, day + clouds screen blend --------------------
+  FileReader day{fopen(argv[1], "rb")}, clouds{fopen(argv[2], "rb")};
+  if (!day.f || !clouds.f) { fprintf(stderr, "cannot open inputs\n"); return 1; }
+  std::vector<uint8_t> buf(tex::RES_BYTES);
+  if (!tex::loadResident(day, &clouds, buf.data())) {
+    fprintf(stderr, "loadResident failed\n"); return 1;
+  }
+  {
+    FILE* r = fopen("ref_resident.bin", "rb");
+    if (!r) { fprintf(stderr, "run tex_ref.py first\n"); return 1; }
+    std::vector<uint8_t> ref(tex::RES_BYTES);
+    fread(ref.data(), 1, ref.size(), r); fclose(r);
+    size_t bad = 0;
+    for (size_t i = 0; i < ref.size(); i++) if (ref[i] != buf[i]) bad++;
+    printf("A resident load vs python: %zu/%u bytes differ %s\n",
+           bad, tex::RES_BYTES, bad ? "FAIL" : "OK");
+    if (bad) return 1;
+  }
+
+  // ---------- B: projection LUT path vs double precision ---------------------
+  tex::Luts L; L.build();
+  {
+    const float views[4][2] = {{45.35f, -75.76f}, {0, 0}, {85, 10}, {-60, 179}};
+    long total = 0, tyOff = 0, txOff = 0, tyBad = 0; int tyMax = 0; double txMaxE = 0;
+    for (auto& v : views) {
+      const globe::Basis B = globe::viewBasis(v[0], v[1]);
+      for (int Y = CY - R; Y <= CY + R; Y++) {
+        const double py = (double)(CY - Y) / R;
+        for (int X = CX - R; X <= CX + R; X++) {
+          const double px = (double)(X - CX) / R;
+          const double r2 = px * px + py * py;
+          if (r2 >= 1.0) continue;
+          total++;
+          const double pz = sqrt(1.0 - r2);
+          const double wx = B.m[0]*px + B.m[3]*py + B.m[6]*pz;
+          const double wy = B.m[1]*px + B.m[4]*py + B.m[7]*pz;
+          const double wz = B.m[5]*py + B.m[8]*pz;
+          int tyR = (int)((0.5 - asin(fmin(1.0, fmax(-1.0, wz))) / M_PI) * tex::RES_H);
+          if (tyR >= tex::RES_H) tyR = tex::RES_H - 1;
+          if (tyR < 0) tyR = 0;
+          int txR = (int)(((atan2(wy, wx) / M_PI + 1.0) / 2.0) * tex::RES_W);
+          txR = ((txR % tex::RES_W) + tex::RES_W) % tex::RES_W;
+
+          const float pzf = (float)L.pz[(int)(r2 * 4096.0)] * (1.0f / 65535.0f);
+          const float wxf = B.m[0]*(float)px + B.m[3]*(float)py + B.m[6]*pzf;
+          const float wyf = B.m[1]*(float)px + B.m[4]*(float)py + B.m[7]*pzf;
+          const float wzf = B.m[5]*(float)py + B.m[8]*pzf;
+          int zi = (int)((wzf + 1.0f) * 1024.0f);
+          if (zi < 0) zi = 0; if (zi > 2048) zi = 2048;
+          const int tyC = L.ty[zi];
+          const int txC = tex::txFrom(L, wxf, wyf);
+
+          int dy = abs(tyC - tyR);
+          int dx = abs(txC - txR); dx = dx > tex::RES_W/2 ? tex::RES_W - dx : dx;
+          const double coslat = cos(asin(fmin(1.0, fmax(-1.0, wz))));
+          const double dxe = dx * coslat;      // error in surface texels
+          if (dy) { tyOff++; if (dy > tyMax) tyMax = dy; }
+          if (dxe > 0.5) { txOff++; }
+          if (dxe > txMaxE) txMaxE = dxe;
+          if (dy > 1 && fabs(wz) < 0.996) tyBad++;   // |lat| < ~85 deg
+        }
+      }
+    }
+    printf("B projection: %ld px | ty!=ref %.2f%% (max %d, >1 off-pole: %ld px)"
+           " | tx surface-err >0.5 texel %.2f%% (max %.2f texels)\n",
+           total, 100.0*tyOff/total, tyMax, tyBad, 100.0*txOff/total, txMaxE);
+  }
+
+  // ---------- C: FS bit-exactness on a synthetic ramp -------------------------
+  {
+    // gray[y][x] known values, dithered by the SAME loop the renderer uses;
+    // here we call renderPhotoGlobe with a fake 'buf' replaced by a ramp
+    // sampler -- instead, exercise the exact arithmetic in a local copy fed
+    // to plot: simplest faithful route is a tiny image dithered with the
+    // identical integer rules, compared against tex_ref.py.
+    const int w = 64, h = 64;
+    std::vector<uint8_t> out(w * h, 0);
+    std::vector<int16_t> err(2 * (w + 2), 0);
+    int16_t *cur = err.data(), *nxt = err.data() + (w + 2);
+    for (int y = 0; y < h; y++) {
+      const bool ltr = (y & 1) == 0;
+      const int xa = ltr ? 0 : w - 1, xb = ltr ? w - 1 : 0, xs = ltr ? 1 : -1;
+      int carry = 0;
+      for (int x = xa; ltr ? x <= xb : x >= xb; x += xs) {
+        const int v = ((x * 4 + y * 2) % 16) * 17;   // same ramp as tex_ref.py
+        const int want = v + cur[x + 1] + carry;
+        const int outv = want >= 128 ? 255 : 0;
+        const int e = want - outv;
+        out[y * w + x] = (uint8_t)outv;
+        carry = (e * 7) >> 4;
+        nxt[x + 1 - xs] = (int16_t)(nxt[x + 1 - xs] + ((e * 3) >> 4));
+        nxt[x + 1]      = (int16_t)(nxt[x + 1] + ((e * 5) >> 4));
+        nxt[x + 1 + xs] = (int16_t)(nxt[x + 1 + xs] + ((e * 1) >> 4));
+      }
+      int16_t* t = cur; cur = nxt; nxt = t;
+      memset(nxt, 0, sizeof(int16_t) * (w + 2));
+    }
+    FILE* r = fopen("ref_fs.bin", "rb");
+    if (!r) { fprintf(stderr, "run tex_ref.py first\n"); return 1; }
+    std::vector<uint8_t> ref(w * h);
+    fread(ref.data(), 1, ref.size(), r); fclose(r);
+    size_t bad = 0;
+    for (size_t i = 0; i < ref.size(); i++) if (ref[i] != out[i]) bad++;
+    printf("C floyd-steinberg vs python: %zu/%d px differ %s\n",
+           bad, w * h, bad ? "FAIL" : "OK");
+    if (bad) return 1;
+  }
+
+  // ---------- D: full render to PGM -------------------------------------------
+  {
+    std::vector<uint8_t> img((size_t)W * H, 255);
+    const globe::Basis B = globe::viewBasis(45.35f, -75.76f);
+    std::vector<int16_t> err(2 * (W + 2));
+    tex::FsRow fs{err.data(), W};
+    tex::renderPhotoGlobe(B, CX, CY, R, 0, 0, W, H, buf.data(), L, fs,
+                          [&](int x, int y, bool white) {
+                            img[(size_t)y * W + x] = white ? 255 : 0;
+                          });
+    FILE* o = fopen("render.pgm", "wb");
+    fprintf(o, "P5\n%d %d\n255\n", W, H);
+    fwrite(img.data(), 1, img.size(), o);
+    fclose(o);
+    printf("D wrote render.pgm (%dx%d, view 45.35,-75.76, day+clouds)\n", W, H);
+  }
+  return 0;
+}
